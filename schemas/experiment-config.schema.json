{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/pdarts-skin-transferability/experiment-config.schema.json",
  "title": "P-DARTS skin-transferability experiment configuration",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "experiment_family",
    "method",
    "result_namespace",
    "source_dataset",
    "target_datasets",
    "resolution",
    "seeds",
    "upstream_core_policy",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^E[0-9]+[A-Z]?$"
    },
    "experiment_family": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "result_namespace": {
      "const": "reproduction"
    },
    "source_dataset": {
      "enum": [
        "isic_2019",
        "pad_ufes_20",
        "dermamnist"
      ]
    },
    "target_datasets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "isic_2019",
          "pad_ufes_20",
          "dermamnist"
        ]
      }
    },
    "resolution": {
      "enum": [32, 224]
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "upstream_core_policy": {
      "const": "external_authorized_dependency_required"
    },
    "status": {
      "enum": [
        "specified_not_executed",
        "executed",
        "blocked"
      ]
    }
  },
  "additionalProperties": true
}
